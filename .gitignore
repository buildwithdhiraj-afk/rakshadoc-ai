# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Environment
.env
.env.local
.env.production
.env.backup

# Build outputs
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# ML artifacts (if model weights are added later)
*.pt
*.onnx
*.pth
*.joblib
*.pkl

# Tesseract traineddata — ~7 MB of binaries. Run `python scripts/fetch_tessdata.py`
# once after cloning. The system Program Files copy is not writable without admin
# rights, so the backend keeps its own at backend/tessdata.
backend/tessdata/

# Uploaded documents & databases — never commit documents or databases to git
data/uploads/*
data/storage/*
backend/data/*
!data/uploads/.gitkeep
!data/storage/.gitkeep
!backend/data/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Test / coverage
coverage/
htmlcov/
.jest/
*.lcov

# Misc
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
