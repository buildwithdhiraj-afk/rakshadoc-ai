# ─── RakshaDoc AI ─────────────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# Backend
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=postgresql+psycopg2://rakshadoc:rakshadoc@localhost:5432/rakshadoc

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=25
MAX_PAGES=100
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,tif,bmp,webp

# Demo mode (true = use clearly-labelled simulated analysis until real models are connected)
DEMO_MODE=true
DEMO_SEED=42

# CORS — frontend origins (never use * with authenticated/private data)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Public verification base URL
PUBLIC_BASE_URL=http://localhost:3000

# Retention policy (days before documents are eligible for cleanup)
RETENTION_DAYS=90

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
